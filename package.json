{
  "name": "@furcdn/cli",
  "version": "0.2.0",
  "description": "FurCDN 官方命令列工具",
  "license": "MIT",
  "author": "LangYa466",
  "type": "module",
  "bin": {
    "furcdn": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --test $(find dist -name '*.test.js')",
    "pretest": "npm run build",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurCDN/furcdn-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
